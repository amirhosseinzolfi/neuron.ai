[Unit]
Description=Blue Psychology Full FastAPI Server (TTS, Image, Profile)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/blue-psychology-test
Environment="PATH=/root/blue-psychology-test/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/root/blue-psychology-test"
ExecStart=/root/blue-psychology-test/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 15800 --reload
Restart=always
RestartSec=10
StandardOutput=append:/root/blue-psychology-test/logs/api.log
StandardError=append:/root/blue-psychology-test/logs/api_error.log

[Install]
WantedBy=multi-user.target
