# Blue Psychology Test Bot - Environment Variables Example
# Copy this file to .env and fill in the values

# ============================================
# GOOGLE GEMINI API KEYS
# Get from: https://makersuite.google.com/app/apikey
# ============================================
GOOGLE_API_KEY_PRIMARY=your_primary_key_here
GOOGLE_API_KEY_SECONDARY=your_secondary_key_here
GOOGLE_API_KEY_ANALYZE=your_analyze_key_here
GOOGLE_API_KEY_IMAGE=your_image_key_here
GOOGLE_API_KEY_HISTORY=your_history_key_here
GOOGLE_API_KEY_NEURON=your_neuron_key_here
GOOGLE_API_KEY_USER_INFO=your_user_info_key_here
GOOGLE_API_KEY_MCP=your_mcp_key_here

# ============================================
# TELEGRAM BOT
# Get from: @BotFather
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# OPENAI COMPATIBLE API (G4F)
# ============================================
OPENAI_BASE_URL=http://localhost:15207/v1
OPENAI_MODEL=gemini-flash-latest

# ============================================
# AI HISTORY SETTINGS
# ============================================
AI_HISTORY_TRIM_THRESHOLD=15
AI_HISTORY_RETENTION=5
AI_HISTORY_SUMMARY_INTERVAL=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
