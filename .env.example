# ============================================
# Blue Psychology Test Bot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ============================================
# GOOGLE GEMINI API KEYS
# ============================================
# Get your API keys from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY_PRIMARY=your_google_api_key_here
GOOGLE_API_KEY_SECONDARY=your_secondary_google_api_key_here
GOOGLE_API_KEY_ANALYZE=your_analyze_api_key_here
GOOGLE_API_KEY_IMAGE=your_image_api_key_here
GOOGLE_API_KEY_HISTORY=your_history_api_key_here
GOOGLE_API_KEY_NEURON=your_neuron_api_key_here
GOOGLE_API_KEY_USER_INFO=your_user_info_api_key_here
GOOGLE_API_KEY_MCP=your_mcp_api_key_here
GOOGLE_API_KEY_VOICE=your_voice_api_key_here
GOOGLE_API_KEY_VOICE2=your_voice2_api_key_here
GOOGLE_API_KEY_VOICE3=your_voice3_api_key_here
GOOGLE_API_KEY_PROFILE=your_profile_api_key_here
GOOGLE_API_KEY=your_default_google_api_key_here

# ============================================
# TELEGRAM BOT
# ============================================
# Get your bot token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# OPENAI COMPATIBLE API (G4F)
# ============================================
OPENAI_BASE_URL=http://localhost:15207/v1
OPENAI_MODEL=gemini-flash-latest

# ============================================
# AI HISTORY SETTINGS
# ============================================
AI_HISTORY_TRIM_THRESHOLD=15
AI_HISTORY_RETENTION=5
AI_HISTORY_SUMMARY_INTERVAL=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# MEM0 LONG-TERM MEMORY
# ============================================
LONGTERM_MEM0=true
MEM0_TOPK=3
MEM0_COLLECTION=mem0_nomic_768
MEM0_AGENT_ID=blue-psychology-agent
MEM0_EMBED_MODEL=nomic-embed-text
MEM0_EMBED_DIM=768

# ============================================
# QDRANT VECTOR DATABASE
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# ============================================
# OLLAMA LOCAL EMBEDDINGS
# ============================================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================
# MEMORY API SETTINGS
# ============================================
MEMORY_API_BASE_URL=http://localhost:15800
MEMORY_API_TIMEOUT=60.0
MEMORY_API_SEARCH_LIMIT=5

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///./database/psychology_bot.db

# ============================================
# API CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# ADMIN USERS
# ============================================
# Comma-separated Telegram user IDs
ADMIN_USERS=123456789,987654321
