# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI/LLM Configuration
OPENAI_API_KEY=your_api_key_here
SECONDARY_OPENAI_API_KEY=your_secondary_api_key_here
OPENAI_BASE_URL=http://localhost:15207/v1
OPENAI_MODEL=gemini-2.5-flash

# AI History Management
AI_HISTORY_TRIM_THRESHOLD=15
AI_HISTORY_RETENTION=5
AI_HISTORY_SUMMARY_INTERVAL=5

# Database
DATABASE_URL=sqlite:///./database/psychology_bot.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Memory Configuration
MEM0_API_KEY=your_mem0_api_key_here
QDRANT_URL=http://localhost:6333

# Logging
LOG_LEVEL=INFO
ENABLE_JSONL_LOGGING=true

# Admin Users (comma-separated Telegram user IDs)
ADMIN_USERS=123456789,987654321
